# ------------------------------------------------------------------------------
# CLI Argument Dispatcher
# ------------------------------------------------------------------------------
if __FILE__ == $PROGRAM_NAME
  options = {
    rule_pack: File.join(RULES_DIR, 'eu-ai-act-iso42001-nist-v1.sealed-pack.json'),
    output_dir: '.',
    offline: true,
    allow_unsigned: false,
    allow_private: false
  }

  parser = OptionParser.new do |opts|
    opts.banner = 'Usage: sealed [command] [options]'
    opts.separator ''
    opts.separator 'Commands:'
    opts.separator '  scan <path>      Run compliance & safety audit against target project'
    opts.separator '  verify <zip>     Verify integrity of evidence.zip hash chain'
    opts.separator ''
    opts.separator 'Options:'

    opts.on('-r', '--rule-pack PATH', 'Path to signed rule pack') do |v|
      options[:rule_pack] = v
    end

    opts.on('-o', '--output-dir PATH', 'Output directory for report and evidence.zip') do |v|
      options[:output_dir] = v
    end

    opts.on('--offline', 'Enforce strictly offline scan (default: true)') do |v|
      options[:offline] = v
    end

    opts.on('--allow-unsigned-rules', 'Permit loading unsigned or untrusted rule packs (UNSAFE)') do
      options[:allow_unsigned] = true
    end

    opts.on('--allow-private-endpoints', 'Permit connecting to private RFC1918 / loopback endpoints') do
      options[:allow_private] = true
    end

    opts.on('-h', '--help', 'Show this message') do
      puts opts
      exit 0
    end
  end

  # Use parse! to allow options before or after subcommands
  parser.parse!(ARGV)
  command = ARGV.shift

  case command
  when 'scan'
    target = ARGV.shift
    unless target
      warn '[FATAL] Missing target project directory path. Usage: sealed scan <path>'
      exit 2
    end

    puts '============================================================'
    puts ' SEALED — Local-First AI Compliance & Safety Auditor v1.0.0'
    puts " Target:    #{target}"
    puts " Rule Pack: #{options[:rule_pack]}"
    puts " Mode:      #{options[:offline] ? 'OFFLINE' : 'STANDARD'} | Network Egress: DENIED"
    puts '============================================================'

    begin
      result = Auditor.run(
        target,
        options[:rule_pack],
        options[:output_dir],
        allow_unsigned: options[:allow_unsigned],
        allow_private: options[:allow_private]
      )

      puts " [+] Written audit report: #{result[:report_path]}"
      puts " [+] Written deterministic evidence pack: #{result[:zip_path]}"
      puts "     Hash Chain Blocks: #{result[:chain].size}"
      puts "     Final Chain Hash:   #{result[:manifest][:final_chain_hash]}"
      puts '------------------------------------------------------------'

      if result[:has_violations]
        warn " [!] AUDIT FAILED: Discovered #{result[:findings].size} compliance & safety violations."
        result[:findings].each do |f|
          warn "     * [#{f[:severity]}] #{f[:control_id]} - #{f[:title]} (#{f[:file_path]}:#{f[:line_number]})"
        end
        exit 1
      else
        puts ' [OK] AUDIT PASSED: Zero compliance or safety violations discovered.'
        exit 0
      end
    rescue SealedSecurityError => e
      warn "[FATAL SECURITY VIOLATION] #{e.message}"
      exit 2
    rescue SealedRulePackError => e
      warn "[FATAL RULE PACK ERROR] #{e.message}"
      exit 2
    rescue StandardError => e
      warn "[FATAL AUDIT ERROR] #{e.message} (#{e.class})"
      exit 2
    end

  when 'verify'
    zip_target = ARGV.shift
    unless zip_target && File.file?(zip_target)
      warn '[FATAL] Please provide a valid evidence.zip file path.'
      exit 2
    end

    puts "Verifying evidence pack: #{zip_target}"
    begin
      # Test extraction with zip-slip guard
      out_temp = File.join('/tmp', "sealed_verify_#{Process.pid}")
      FileUtils.mkdir_p(out_temp)
      system("/usr/bin/unzip -q -o #{zip_target} -d #{out_temp}")

      chain_file = File.join(out_temp, 'chain.json')
      manifest_file = File.join(out_temp, 'manifest.json')
      unless File.file?(chain_file) && File.file?(manifest_file)
        raise SealedSecurityError, 'Archive missing chain.json or manifest.json'
      end

      chain = JSON.parse(File.read(chain_file))
      manifest = JSON.parse(File.read(manifest_file))

      # Verify chain continuity
      chain.each_with_index do |block, i|
        if i > 0 && block['prev_hash'] != chain[i - 1]['block_hash']
          raise SealedSecurityError, "Hash chain link broken at block #{i}"
        end
      end

      if chain.last && chain.last['block_hash'] != manifest['final_chain_hash']
        raise SealedSecurityError, 'Final chain hash does not match manifest'
      end

      puts " [OK] Hash chain verified: #{chain.size} blocks with intact cryptographic continuity."
      FileUtils.rm_rf(out_temp)
      exit 0
    rescue StandardError => e
      warn "[FAIL] Verification failed: #{e.message}"
      exit 2
    end

  else
    warn "Unknown command: '#{command}'. Run 'sealed --help' for usage."
    exit 2
  end
end
